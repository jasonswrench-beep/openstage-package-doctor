{
  "name": "openstage-package-doctor-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Opens a SCORM 1.2, SCORM 2004, xAPI or cmi5 package and checks whether it will run. Used by the Package Doctor window and its command line.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "node src/cli.ts",
    "docs": "node tools/make-checks-doc.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
