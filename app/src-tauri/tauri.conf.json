{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenStage Package Doctor",
  "mainBinaryName": "openstage-package-doctor",
  "version": "0.5.0",
  "identifier": "com.openstageauthor.packagedoctor",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "node build.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenStage Package Doctor",
        "width": 1200,
        "height": 860,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Jason S. Wrench",
    "copyright": "Copyright 2026 Jason S. Wrench and the OpenStage Package Doctor contributors",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Opens and checks a course package with no source file",
    "category": "Education",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
